{
  "name": "triangulator-dashboard",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "build:scout": "tsc --noEmit && vite build --config vite.scout.config.ts",
    "check": "tsc --noEmit && eslint . && prettier --check . && vitest run && node scripts/check-pure-parity.mjs",
    "format": "prettier --write .",
    "check:controls": "node scripts/check-negative-controls.mjs",
    "check:oracle-source": "node scripts/parity-oracle.mjs --verify-source"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "smol-toml": "1.9.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vite-plugin-singlefile": "2.3.4",
    "vitest": "5.0.5"
  }
}
