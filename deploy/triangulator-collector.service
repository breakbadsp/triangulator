[Unit]
Description=Triangulator collector and dashboard (C++, no alerting)

[Service]
Type=simple
WorkingDirectory=%h/triangulator
ExecStart=%h/triangulator/bin/triangulator-collector %h/triangulator/config/collector.toml
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=1G
StandardOutput=append:%h/triangulator/logs/collector.log
StandardError=append:%h/triangulator/logs/collector.log

[Install]
WantedBy=default.target
