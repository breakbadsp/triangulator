[Unit]
Description=Triangulator read-only thread sampler
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mybackend
ExecStart=/usr/local/bin/triangulator-sampler /etc/triangulator/sampler.toml
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5
Nice=19
CPUQuota=5%
MemoryMax=32M
LimitNOFILE=24576
TasksMax=2
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallFilter=@system-service
SystemCallFilter=~@debug
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
IPAddressDeny=any
IPAddressAllow=10.0.0.5
StandardOutput=journal
StandardError=journal
LogRateLimitIntervalSec=60
LogRateLimitBurst=5

[Install]
WantedBy=multi-user.target
