[Unit]
Description=Triangulator read-only thread sampler

[Service]
Type=simple
WorkingDirectory=%h/triangulator
ExecStart=%h/triangulator/bin/triangulator-sampler %h/triangulator/config/sampler.toml
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5
Nice=19
CPUQuota=5%
MemoryMax=32M
LimitNOFILE=24576
TasksMax=2
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
# AF_NETLINK: resource samples read socket queues through sock_diag.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
StandardOutput=append:%h/triangulator/logs/sampler.log
StandardError=append:%h/triangulator/logs/sampler.log

[Install]
WantedBy=default.target
